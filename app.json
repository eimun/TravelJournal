{
  "expo": {
    "name": "TravelBuddy",
    "slug": "TravelJournal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "travelbuddy",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5ead8",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5ead8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.travelbuddy.companion"
    },
    "android": {
      "package": "app.travelbuddy.companion",
      "versionCode": 1,
      "minSdkVersion": 30,
      "adaptiveIcon": {
        "backgroundColor": "#f5ead8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
