# Copy to .env.local (git-ignored) and fill in. Restart `npm start` after changing it.

# Live restaurant search (Ola Maps, free tier, no card needed).
# Get a key: cloud.olakrutrim.com -> Ola Maps -> Maps Credentials -> New Credentials.
# Leave empty to fall back to OpenStreetMap.
EXPO_PUBLIC_OLA_MAPS_API_KEY=
