{
  "name": "traveljournal",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "deps:check": "expo install --check",
    "logs:start": "node scripts/logs.js start",
    "logs:live": "node scripts/logs.js live",
    "logs:pull": "node scripts/logs.js pull",
    "logs:open": "node scripts/logs.js open",
    "logs:clear": "node scripts/logs.js clear",
    "verify:restaurants": "node --no-warnings --import ./scripts/lib/register-esm.mjs scripts/verify-restaurants.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/caprasimo": "^0.4.0",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-location": "~58.0.20",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "app/**/*.js",
      "src/**/*.js",
      "!app/data/**"
    ],
    "coverageThreshold": {
      "./src/domain/": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      },
      "./app/components/trailGeometry.js": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
